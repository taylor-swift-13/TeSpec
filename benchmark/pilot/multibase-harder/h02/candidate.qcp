With old_rows old_audit
Require
  GridHeap::full(grid, old_rows, old_audit, 3, 4) &&
  Rows3x4(old_rows) &&
  GridArithmeticSafe(old_rows, bias)
Ensure
  exists new_rows new_audit,
    GridHeap::full(grid, new_rows, new_audit, 3, 4) &&
    GridSummaryStep(old_rows, bias@pre,
                    new_rows, new_audit, __return)
