With nodes values stamps old_mutations
Require
  Four(nodes) &&
  Four(values) &&
  Four(stamps) &&
  NoDup(nodes) &&
  DLL4QueueHeap::full(queue, nodes, values, stamps, old_mutations) &&
  QueueArithmeticSafe(values, old_mutations)
Ensure
  exists post_nodes post_values post_stamps,
    RotateTwo(nodes, post_nodes) &&
    RotateTwo(values, post_values) &&
    RotateTwo(stamps, post_stamps) &&
    DLL4QueueHeap::full(queue, post_nodes, post_values, post_stamps,
                        old_mutations + 2) &&
    ReturnHeadTail(post_values, __return) &&
    HeadLeTail(post_values)
