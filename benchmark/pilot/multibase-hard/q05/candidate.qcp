With tail h0 h1 hd t0 t1 td
Require
  DLL2Heap::full(head, tail, h0, h1, hd, t0, t1, td) &&
  TwoNodeArithmeticSafe(h0, hd, t0, td)
Ensure
  exists tail_after,
    DLL2Heap::full(head, tail,
                   h0 + hd, h1, hd,
                   tail_after, t1, td) &&
    __return == h0 + hd + tail_after &&
    EvenReturn(__return)
