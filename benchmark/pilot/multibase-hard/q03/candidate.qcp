With old_X coeff old_pid prd
Require
  Zlength(old_X) == 8 &&
  Zlength(coeff) == 18 &&
  Zlength(old_pid) == 3 &&
  FilterHeap::full(X, f, pid, global_prd, old_X, coeff, old_pid, prd) &&
  FilterArithmeticSafe(old_X, coeff, old_pid, Ang, dAng, prd)
Ensure
  exists new_X ret,
    CandidateSFExact(old_X, coeff, old_pid, Ang@pre, dAng@pre, prd,
                     new_X, ret) &&
    Znth(7, new_X, 0) == Znth(7, old_X, 0) &&
    __return == ret &&
    FilterHeap::full(X, f, pid, global_prd,
                     new_X, coeff, old_pid, prd)
