/* The benchmark domain D, independent of the candidate specification.

   IntArray::full(state, 3, l) means that state points to exactly three
   writable integer cells whose initial mathematical contents are l.
*/
With l
Require
  state != 0 &&
  0 < area_length &&
  area_length <= 1073741824 &&
  Zlength(l) == 3 &&
  IntArray::full(state, 3, l) &&
  0 <= l[0] &&
  l[0] < area_length &&
  0 <= l[1] &&
  l[1] < area_length &&
  0 <= data_length &&
  data_length <= area_length
