      "qcp_functions": {
        "abs_mem": {
          "return_type": "int",
          "parameters": "int *p",
          "contract": "/*@ With v Require -2147483648 < v && data_at(p, int, v) Ensure ((v >= 0 && __return == v) || (v < 0 && __return == -v)) && data_at(p, int, v) */",
          "body": "\n  int x = *p;\n  if (x >= 0) {\n    return x;\n  }\n  else {\n    return -x;\n  }\n"
        },
        "abs_y": {
          "return_type": "int",
          "parameters": "struct tuple *p",
          "contract": "/*@ With x y Require -2147483648 < y && data_at(&p->x, int, x) * data_at(&p->y, int, y) Ensure ((y >= 0 && __return == y) || (y < 0 && __return == -y)) && data_at(&p->x, int, x) * data_at(&p->y, int, y) */",
          "body": "\n  return abs_mem(&p->y);\n"
        }
      },
      "cn_specifications": [
        "/*@ requires take x = Owned<int>(p);\n             MINi32() < x;\n    ensures take x2 = Owned<int>(p);\n            x == x2;\n            return == ((x >= 0i32) ? x : (0i32-x));\n@*/",
        "/*@ requires take s = Owned(p);\n             MINi32() < s.y;\n    ensures  take s2 = Owned(p);\n             s == s2;\n             return == ((s.y >= 0i32) ? s.y : (0i32-s.y));\n@*/",
