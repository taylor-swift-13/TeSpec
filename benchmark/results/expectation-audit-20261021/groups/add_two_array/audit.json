      "qcp_functions": {
        "array_read_two": {
          "return_type": "unsigned int",
          "parameters": "unsigned int *p, int n, int i, int j",
          "contract": "/*@ With (l: list Z) Require 0 <= i && i < n && 0 <= j && j < n && i != j && 0 <= Znth(i,l,0) && Znth(i,l,0) <= 4294967295 && 0 <= Znth(j,l,0) && Znth(j,l,0) <= 4294967295 && UIntArray::full(p,n,l) Ensure __return == (Znth(i,l,0)+Znth(j,l,0))%4294967296 && UIntArray::full(p,n,l) */",
          "body": "\n  unsigned int tmp1 = p[i];\n  unsigned int tmp2 = p[j];\n  return (tmp1 + tmp2);\n"
        }
      },
      "cn_specifications": [
        "/*@ requires take a1 = each(i32 k; 0i32 <= k && k < n) { Owned<unsigned int>(array_shift<unsigned int>(p,k)) };\n             0i32 <= i && i < n;\n             0i32 <= j && j < n;\n             j != i;\n    ensures take a2 = each(i32 k; 0i32 <= k && k < n) { Owned<unsigned int>(array_shift<unsigned int>(p,k)) };\n            a1 == a2;\n            return == a1[i] + a1[j];\n@*/",
        "/*@ extract Owned<unsigned int>, i; @*/",
        "/*@ extract Owned<unsigned int>, j; @*/",
        "/*@ trusted; @*/",
        "/*@ assert (res == 12u32); @*/",
        "/*@ assert (res == 13u32); @*/"
      ],
