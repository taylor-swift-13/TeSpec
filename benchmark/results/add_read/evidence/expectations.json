        "add": {
          "return_type": "unsigned int",
          "parameters": "unsigned int *p, unsigned int *q",
          "contract": "/*@ With v w Require 0 <= v && v <= 4294967295 && 0 <= w && w <= 4294967295 && data_at(p, unsigned int, v) * data_at(q, unsigned int, w) Ensure __return == (v+w) % 4294967296 && data_at(p, unsigned int, v) * data_at(q, unsigned int, w) */",
          "body": "\n  unsigned int m = *p;\n  unsigned int n = *q;\n  return m+n;\n"
        }
      },
      "cn_specifications": [
        "/*@ requires take m = Owned<unsigned int>(p);\n             take n = Owned<unsigned int>(q);\n    ensures take m2 = Owned<unsigned int>(p);\n            take n2 = Owned<unsigned int>(q);\n            m == m2 && n == n2;\n            return == m + n;\n@*/",
        "/*@ trusted; @*/",
        "/*@ assert (x == 5u32); @*/",
        "/*@ assert (y == 7u32); @*/",
        "/*@ assert (res == 12u32); @*/"
