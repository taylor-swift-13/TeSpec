{
  "schema": "tespec-bidirectional-hidden-suite/v1",
  "source_states": "hidden/states.json",
  "groups": [
    {
      "id": "preservation",
      "description": "Inactive updates preserve the old mode.",
      "cases": [
        "preserve_below_both",
        "inject_one_below",
        "late_other_mode_preserve",
        "preserve_max_old_mode",
        "preserve_mode_four"
      ],
      "mutants": [
        "h01_inject_reversed_le.c",
        "h04_inject_adds_t0.c"
      ]
    },
    {
      "id": "injection",
      "description": "The orbit-injection threshold writes mode 1.",
      "cases": [
        "all_zero_inject_boundary",
        "inject_exact",
        "negative_inject_exact",
        "negative_inject_delay",
        "large_inject_boundary"
      ],
      "mutants": [
        "m01_inject_strict_gt.c",
        "m02_inject_wrong_value.c",
        "m08_omit_inject_write.c",
        "h04_inject_adds_t0.c"
      ]
    },
    {
      "id": "next_mode_1",
      "description": "A late next-mode 1 request writes mode 2.",
      "cases": [
        "late_next1_without_inject",
        "late_next1_with_inject",
        "negative_late_next1",
        "negative_switch_delay_next1",
        "large_late_next1"
      ],
      "mutants": [
        "m06_next1_wrong_flag.c",
        "m07_next1_wrong_value.c",
        "h03_omit_next1_write.c"
      ]
    },
    {
      "id": "next_mode_2",
      "description": "A late next-mode 2 request writes mode 5.",
      "cases": [
        "late_next2_without_inject",
        "late_next2_with_inject",
        "negative_late_next2",
        "large_late_next2",
        "switch_exact_next2_preserve"
      ],
      "mutants": [
        "m03_next2_boundary_ge.c",
        "m04_next2_wrong_flag.c",
        "m05_next2_wrong_value.c",
        "h01_inject_reversed_le.c",
        "h02_omit_next2_write.c",
        "h04_inject_adds_t0.c"
      ]
    },
    {
      "id": "write_precedence",
      "description": "Later mode-switch writes override an earlier injection write.",
      "cases": [
        "switch_exact_next1_inject",
        "inject_then_overwrite_next1",
        "inject_then_overwrite_next2",
        "next1_nonlate_preserve",
        "next2_nonlate_inject"
      ],
      "mutants": [
        "m01_inject_strict_gt.c",
        "m02_inject_wrong_value.c",
        "m04_next2_wrong_flag.c",
        "m05_next2_wrong_value.c",
        "m06_next1_wrong_flag.c",
        "m07_next1_wrong_value.c",
        "m08_omit_inject_write.c",
        "h01_inject_reversed_le.c",
        "h02_omit_next2_write.c",
        "h03_omit_next1_write.c"
      ]
    },
    {
      "id": "combined_boundaries",
      "description": "Strict and non-strict boundaries interact with other modes.",
      "cases": [
        "late_other_mode_with_inject",
        "late_max_next_mode_preserve",
        "both_boundaries_other_mode",
        "switch_one_above_next1",
        "negative_double_boundary"
      ],
      "mutants": [
        "m01_inject_strict_gt.c",
        "m02_inject_wrong_value.c",
        "m03_next2_boundary_ge.c",
        "m04_next2_wrong_flag.c",
        "m06_next1_wrong_flag.c",
        "m07_next1_wrong_value.c",
        "m08_omit_inject_write.c",
        "h01_inject_reversed_le.c",
        "h03_omit_next1_write.c",
        "h04_inject_adds_t0.c"
      ]
    }
  ]
}
