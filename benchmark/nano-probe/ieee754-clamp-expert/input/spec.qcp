With inputs lowers uppers old_outputs old_flags
Require
  FloatBatchHeap::full(samples, count,
                       inputs, lowers, uppers, old_outputs, old_flags) &&
  BatchDomain(inputs, lowers, uppers) &&
  BatchCounterSafe(count)
Ensure
  exists outputs flags_after,
    FloatBatchHeap::full(samples, count,
                         inputs, lowers, uppers, outputs, flags_after) &&
    ClampBatchNumeric(inputs, lowers, uppers, outputs) &&
    AllNonNaN(outputs) &&
    __return == ClampCount(inputs, lowers, uppers)
