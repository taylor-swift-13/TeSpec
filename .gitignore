# Preserve auditable logs for independently measured read ITP executions.
!/benchmark/results/read/20261015-itp-per-execution/**/*.log

# Preserve paired spatial-SMT benchmark logs.
!/benchmark/results/read/20261015-spatial-smt/**/*.log

# Preserve auditable logs for the sequential abs group evaluation.
!/benchmark/results/abs/20261016-*/**/*.log

# Preserve auditable logs for abs_mem group evaluation and proof stages.
!/benchmark/results/abs_mem/20261016-*/**/*.log

# Preserve abs_mem_struct execution and every proof-attempt audit log.
!/benchmark/results/abs_mem_struct/20261016-*/**/*.log

# Preserve audited add and add_read evaluation/model/Coq logs.
!/benchmark/results/add/20261016-*/**/*.log
!/benchmark/results/add_read/20261016-*/**/*.log

# Auditable logs for the remaining groups in this explicitly authorized night run.
!/benchmark/results/*/20261016-evaluation/**/*.log
!/benchmark/results/*/20261016-primary-native/**/*.log
!/benchmark/results/*/20261016-qcp-verify-complete/**/*.log
!/benchmark/results/*/20261016-itp-per-execution/**/*.log
